<Project Sdk="Microsoft.NET.Sdk">
  <!-- The operating system's protected secret stores behind Engine.Security.ICredentialStore
       (Windows DPAPI, macOS Keychain), chosen at run time by the OS - not by the drawing
       backend, since either launcher may run on Windows. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Engine.Platform.Credentials</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Platform\Credentials\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Engine.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>
</Project>
