<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Engine.UiGallery</AssemblyName>
    <RootNamespace>Engine.UiGallery</RootNamespace>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Host\**\*.cs;UI\**\*.cs" />
    <ProjectReference Include="..\Engine.csproj" />
    <ProjectReference Include="..\Engine.UI.csproj" />
    <ProjectReference Include="..\Engine.Platform.Skia.csproj" />
    <Content Include="..\..\Assets\Font\*.otf;..\..\Assets\Font\*.ttf" LinkBase="Assets\Font" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
